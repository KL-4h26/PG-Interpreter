// Программа на PG

function calculate(first, second, act){
    if (act == '+'){
        return first + second
    } elif (act == '-'){
        return first - second
    } elif (act == '*'){
        return first * second
    } elif (act == '/'){
        return first / second
    } else() {
        show($"=== Error: strange act: >act<")
        stop()
    }
}

while (True){
    result := calculate(toint(input("=== first num: ")), toint(input("=== second num: ")), input("=== Act: "))
    show($'=== Result: >result<  ==')
    
    leave := input('? Type "q" if you wanna leave: ')
    if (leave == "q"){
        stop()
    }
}

